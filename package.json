{
  "name": "mint-harness",
  "version": "0.1.0",
  "description": "A cute NVIDIA-powered terminal coding harness.",
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "mint": "./bin/mint.js"
  },
  "scripts": {
    "dev": "bun --conditions=development src/index.tsx",
    "start": "bun src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/agent-loop.test.ts tests/agent-tools.test.ts tests/cat.test.ts tests/cat-art.test.ts tests/config.test.ts tests/nvidia.test.ts tests/storage.test.ts tests/terminal.test.ts tests/tools.test.ts tests/connect.test.ts tests/usage.test.ts tests/message-segments.test.ts",
    "check:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows.ps1"
  },
  "dependencies": {
    "@opentui/core": "0.7.0",
    "@opentui/solid": "^0.7.0",
    "solid-js": "1.9.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "coding",
    "assistant",
    "nvidia",
    "ai",
    "harness",
    "opentui"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/mint-harness.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/mint-harness/issues"
  },
  "homepage": "https://github.com/yourusername/mint-harness#readme"
}
