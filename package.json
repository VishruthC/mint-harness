{
  "name": "mint-harness",
  "version": "0.1.2",
  "description": "A cute NVIDIA-powered terminal coding harness.",
  "type": "module",
  "bin": {
    "minth": "bin/mint.js"
  },
  "scripts": {
    "dev": "bun --conditions=development src/index.tsx",
    "start": "bun src/index.tsx",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "install:minth": "bun scripts/install-minth.ts",
    "first-chat": "bun scripts/first-chat.ts",
    "cat:assets": "bun scripts/cat-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/agent-loop.test.ts tests/agent-tools.test.ts tests/cat-assets.test.ts tests/cat-frame-crop.test.ts tests/cat.test.ts tests/config.test.ts tests/first-chat.test.ts tests/install-minth.test.ts tests/nvidia.test.ts tests/storage.test.ts tests/terminal.test.ts tests/tools.test.ts tests/connect.test.ts tests/usage.test.ts tests/message-segments.test.ts tests/models.test.ts tests/ui-format.test.ts tests/approval.test.ts tests/permission-store.test.ts tests/updater.test.ts",
    "check:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows.ps1"
  },
  "dependencies": {
    "@opentui/core": "0.7.0",
    "@opentui/solid": "^0.7.0",
    "solid-js": "1.9.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/",
    "src/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "bunfig.toml",
    "tsconfig.json",
    ".env.example"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "coding",
    "assistant",
    "nvidia",
    "ai",
    "harness",
    "opentui"
  ],
  "author": "VishruthC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VishruthC/mint-harness.git"
  },
  "bugs": {
    "url": "https://github.com/VishruthC/mint-harness/issues"
  },
  "homepage": "https://github.com/VishruthC/mint-harness#readme"
}
