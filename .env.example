# Required: NVIDIA API key
NVIDIA_API_KEY=

# Optional: NVIDIA OpenAI-compatible endpoint and preferred model
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Agent safety limits (positive integers)
MINT_MAX_TOOL_ROUNDS=12
MINT_MAX_TOOL_CALLS_PER_TURN=24

# Effort level for model reasoning (display only)
MINT_EFFORT=max

# Cat companion (PNG asset packs in src/cat/assets)
MINT_CAT_ENABLED=1
MINT_CAT_ASSET_PACK=default
MINT_CAT_RENDERER=auto
MINT_CAT_ANIMATION=1
MINT_CAT_SCALE=1
MINT_CAT_IDLE_FPS=0
MINT_CAT_WORKING_FPS=0
